# Copy this file to .env.<stage> (e.g. .env.local) and fill in values.
# The file loaded at runtime is selected by APP_ENV (default: local).
# Only this .env.example is committed; the per-stage files are git-ignored.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=local            # local | development | test | staging | production
NODE_ENV=development     # development | test | production
PORT=3000
LOG_LEVEL=debug          # fatal | error | warn | info | debug | trace

# Multi-core: when true, the process forks one worker per CPU core (cluster.ts).
# Leave false in containerised deployments and scale with orchestrator replicas.
CLUSTER_ENABLED=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/app

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=app

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092       # comma-separated list
KAFKA_CLIENT_ID=template-ts7

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
