# Copy this file to .env.<stage> (e.g. .env.local) and fill in values.
# The file loaded at runtime is selected by APP_ENV (default: local) and read via
# Node's native env-file loader (no dotenv dependency).
# Only this .env.example is committed; the per-stage files are git-ignored.
#
# APP_ENV and NODE_ENV are SELECTORS set by the launch script (see package.json)
# or the orchestrator — not by these files:
#   APP_ENV  = which values/secrets to source (local | development | test | staging | production)
#   NODE_ENV = build mode (test/staging/production all build as `production`)
# Only local / development / test use a .env file. staging and production get their
# environment injected by the orchestrator, so no .env.<stage> file exists on disk.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=local            # local | development | test | staging | production
NODE_ENV=development     # development | test | production
PORT=3000
LOG_LEVEL=debug          # fatal | error | warn | info | debug | trace

# Multi-core: when true, the process forks one worker per CPU core (cluster.ts).
# Leave false in containerised deployments and scale with orchestrator replicas.
CLUSTER_ENABLED=false

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX=100               # max requests per window per client

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/app

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_DB=app

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092       # comma-separated list
KAFKA_CLIENT_ID=template-ts7

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
