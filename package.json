{
  "name": "template-ts7",
  "version": "0.1.0",
  "description": "Production-grade Node.js + TypeScript backend template (Express 5, layered architecture, manual DI).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "APP_ENV=local NODE_ENV=development tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "test": "APP_ENV=test NODE_ENV=test vitest run",
    "test:watch": "APP_ENV=test NODE_ENV=test vitest --ui",
    "test:coverage": "APP_ENV=test NODE_ENV=test vitest run --coverage",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.5.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "lefthook": "^2.1.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
