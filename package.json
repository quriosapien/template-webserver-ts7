{
  "name": "template-ts7",
  "version": "0.1.0",
  "description": "Production-grade Node.js + TypeScript backend template (Express 5, layered architecture, manual DI).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.5.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.6",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "lefthook": "^2.1.10",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.2.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
